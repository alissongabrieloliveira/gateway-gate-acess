# URL do WebSocket do backend (ver backend/src/gatewayWs/gatewayWs.js).
# Local: ws://localhost:3333/ws/gateway — produção: wss://<domínio da API>/ws/gateway
BACKEND_WS_URL=ws://localhost:3333/ws/gateway

# Token bruto do gateway_devices, obtido UMA VEZ ao rodar
# `npm run seed` no backend (seeds/002_gateway_provisioning.js). Não há
# como reobter esse valor depois — só o hash fica salvo no banco.
#
# É só isso que essa máquina precisa ter configurado localmente — o
# mapeamento físico (IP/porta/saída/serial da controladora) vem do backend
# pelo próprio WebSocket assim que este processo autentica (ver
# src/outputsStore.js), configurável remotamente rodando o seed do backend
# de novo (inclusive contra o banco de produção), sem precisar editar nada
# nesta máquina.
DEVICE_TOKEN=
